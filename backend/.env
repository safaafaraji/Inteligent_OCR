# Application
APP_NAME=OCR Intelligent Advanced
APP_VERSION=2.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=ocr-intelligent-advanced-secret-key-2024-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OCR Configuration
TESSERACT_PATH=/usr/local/bin/tesseract
DEFAULT_LANGUAGE=fra+eng
CONFIDENCE_THRESHOLD=0.6

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=uploads
STATIC_DIR=static

# Database (for future use)
DATABASE_URL=sqlite:///./ocr_database.db